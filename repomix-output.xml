} from 'lucide-react';
import { Brand, PageIntro, Field, PublicFooter } from '../components/ui';

function PublicShell({ page, setPage, go, onLogin, changeRole, mobileNav, setMobileNav }) {
  useEffect(() => { const fn = () => go('home'); window.addEventListener('na-home', fn); return () => window.removeEventListener('na-home', fn); }, []);
  const links = [['Projects','projects'],['Services','services'],['About','about'],['Career','career'],['Contact','contact']];
  return <>
    <header className="public-header"><div className="public-header-inner"><Brand/><nav className={`public-nav ${mobileNav ? 'nav-open' : ''}`}>{links.map(([label, key]) => <button key={key} className={page === key ? 'active' : ''} onClick={() => go(key)}>{label}</button>)}</nav><div className="header-actions"><button className="text-link portal-link" onClick={onLogin}>Client Portal <ArrowUpRight size={15}/></button><button className="icon-btn mobile-menu" onClick={() => setMobileNav(v => !v)} aria-label="Open menu">{mobileNav ? <X/> : <Menu/>}</button></div></div></header>
    <main>{page === 'home' && <HomePage go={go} onLogin={onLogin}/>} {page === 'projects' && <ProjectsPage go={go}/>} {page === 'project-detail' && <ProjectDetailPage go={go}/>} {page === 'services' && <ServicesPage go={go}/>} {page === 'about' && <AboutPage go={go}/>} {page === 'career' && <CareerPage/>} {page === 'contact' && <ContactPage/>}</main>
    <PublicFooter go={go}/>
  </>;
}

function HomePage({ go, onLogin }) {
  return <>
    <section className="hero"><div className="hero-image"/><div className="hero-shade"/><div className="hero-content wrap"><div className="eyebrow light"><span/> INDEPENDENT ARCHITECTURE STUDIO · JAKARTA</div><h1>Spaces that<br/><em>feel like home.</em></h1><p>Thoughtful architecture shaped by context, clarity, and the way people live.</p><div className="hero-buttons"><button className="btn btn-light" onClick={() => go('projects')}>Explore our work <ArrowUpRight size={16}/></button><button className="btn btn-outline-light" onClick={() => go('contact')}>Start a conversation</button></div><div className="hero-index">01 <span/> 04</div></div><div className="hero-caption">SELECTED ARCHITECTURE / 2024—2026</div></section>
    <section className="intro-section wrap"><div className="eyebrow">01 / THE STUDIO</div><div className="intro-grid"><h2>Designing with<br/><em>intention.</em></h2><div className="intro-text"><p className="lead">We believe architecture is more than a built form. It is a response to place, a reflection of its people, and a framework for everyday life.</p><p>NA Associates is an architecture and design practice creating considered spaces through a collaborative and context-led process.</p><button className="under-link" onClick={() => go('about')}>Discover our approach <ArrowUpRight size={15}/></button></div></div></section>
    <section className="featured-section"><div className="wrap"><div className="section-heading"><div><div className="eyebrow">02 / SELECTED WORKS</div><h2>Spaces with <em>character.</em></h2></div><button className="under-link" onClick={() => go('projects')}>View all projects <ArrowUpRight size={15}/></button></div><div className="featured-grid"><button className="featured-card featured-large" onClick={() => go('project-detail')}><img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1400&q=85"/><span className="featured-meta"><strong>01 / Rumah Teduh</strong><small>RESIDENTIAL · JAKARTA</small></span></button><button className="featured-card" onClick={() => go('project-detail')}><img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1000&q=85"/><span className="featured-meta"><strong>02 / Villa Aruna</strong><small>RESIDENTIAL · BALI</small></span></button></div></div></section>
    <section className="services-strip wrap"><div className="eyebrow">03 / WHAT WE DO</div><div className="services-strip-grid"><h2>From first sketch<br/>to <em>final detail.</em></h2><div className="service-mini-list"><div><span>01</span> Architecture <ArrowUpRight size={15}/></div><div><span>02</span> Interior Design <ArrowUpRight size={15}/></div><div><span>03</span> Design Development <ArrowUpRight size={15}/></div><div><span>04</span> Project Coordination <ArrowUpRight size={15}/></div></div></div></section>
    <section className="contact-band"><div className="wrap contact-band-inner"><div><div className="eyebrow light">04 / LET’S WORK TOGETHER</div><h2>Have a project<br/><em>in mind?</em></h2></div><button className="circle-arrow" onClick={() => go('contact')} aria-label="Contact NA Associates"><ArrowUpRight size={26}/></button></div></section>
  </>;
}

function ProjectsPage({ go }) {
  const [category, setCategory] = useState('All'); const [status, setStatus] = useState('All'); const [q, setQ] = useState('');
  const projects = [
    { name: 'Rumah Teduh', loc: 'Kemang, Jakarta Selatan', cat: 'Residential', status: 'Ongoing', year: '2026', img: 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1400&q=85' },
    { name: 'Villa Aruna', loc: 'Ubud, Bali', cat: 'Residential', status: 'Ongoing', year: '2026', img: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1400&q=85' },
    { name: 'Ruang Karya Office', loc: 'Bandung, Jawa Barat', cat: 'Commercial', status: 'Completed', year: '2025', img: 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1400&q=85' },
    { name: 'Courtyard House', loc: 'Tangerang, Banten', cat: 'Residential', status: 'Completed', year: '2024', img: 'https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1400&q=85' }
  ];
  const visible = projects.filter(p => (category === 'All' || p.cat === category) && (status === 'All' || p.status === status) && `${p.name} ${p.loc}`.toLowerCase().includes(q.toLowerCase()));
  return <><PageIntro eyebrow="PORTFOLIO / 2024—2026" title="Selected" italic="projects." desc="A collection of spaces shaped by their context, purpose, and the people who inhabit them."/><section className="wrap portfolio-section"><div className="portfolio-toolbar"><div className="filter-pills">{['All','Residential','Commercial'].map(v => <button key={v} className={category === v ? 'selected' : ''} onClick={() => setCategory(v)}>{v}</button>)}</div><div className="toolbar-right"><select value={status} onChange={e => setStatus(e.target.value)}><option>All</option><option>Ongoing</option><option>Completed</option></select><div className="search-field"><Search size={15}/><input placeholder="Search projects" value={q} onChange={e => setQ(e.target.value)}/></div></div></div><div className="portfolio-grid">{visible.map((p,i) => <button className="portfolio-card" key={p.name} onClick={() => go('project-detail')}><div className="portfolio-photo"><img src={p.img}/><span className="photo-number">0{i+1}</span></div><div className="portfolio-card-info"><div><strong>{p.name}</strong><small>{p.loc}</small></div><span className="portfolio-type">{p.cat} / {p.year}</span></div></button>)}</div>{!visible.length && <EmptyState title="No projects found" detail="Coba ubah kata kunci atau filter."/>}</section></>;
}
function ProjectDetailPage({ go }) { return <><div className="detail-hero"><img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2000&q=90"/><div className="detail-hero-overlay"><div className="eyebrow light">SELECTED PROJECT / 2026</div><h1>Rumah <em>Teduh.</em></h1><p>Residential · Kemang, Jakarta Selatan</p></div></div><section className="wrap project-detail-content"><div className="project-facts"><div><small>LOCATION</small><strong>Jakarta Selatan</strong></div><div><small>LAND AREA</small><strong>240 m²</strong></div><div><small>BUILDING AREA</small><strong>185 m²</strong></div><div><small>STATUS</small><strong>Ongoing</strong></div></div><div className="project-story"><div className="eyebrow">THE PROJECT</div><div><h2>A quieter rhythm<br/>for <em>everyday life.</em></h2><p>Rumah Teduh explores the relationship between light, material, and the everyday rituals of a family home. The design balances openness and privacy through a sequence of connected spaces and carefully framed views.</p><button className="under-link" onClick={() => go('contact')}>Discuss a similar project <ArrowUpRight size={15}/></button></div></div><div className="detail-gallery"><img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=85"/><img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85"/></div><button className="under-link back-link" onClick={() => go('projects')}><ArrowLeft size={15}/> Back to projects</button></section></>; }
function ServicesPage({ go }) { const items = [['01','Architecture','From spatial planning and concept design to detailed construction documentation.'],['02','Interior Design','Interior environments that connect material, light, function, and atmosphere.'],['03','Design Development','A collaborative process that translates an initial idea into a considered design.'],['04','Project Coordination','Design coordination and documentation support throughout the project journey.']]; return <><PageIntro eyebrow="OUR CAPABILITIES" title="What we" italic="do." desc="A considered approach to architecture and design, from the first conversation to the smallest detail."/><section className="wrap service-page-list">{items.map(([n,t,d]) => <div className="service-page-row" key={n}><span>{n}</span><h2>{t}</h2><p>{d}</p><ArrowUpRight size={19}/></div>)}</section><section className="contact-band"><div className="wrap contact-band-inner"><h2>Let’s shape<br/><em>something meaningful.</em></h2><button className="circle-arrow" onClick={() => go('contact')}><ArrowUpRight/></button></div></section></>; }
function AboutPage({ go }) { return <><PageIntro eyebrow="ABOUT NA ASSOCIATES" title="A practice built on" italic="consideration." desc="We approach every project as a conversation between people, place, and possibility."/><section className="wrap about-layout"><img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1400&q=85"/><div><div className="eyebrow">OUR APPROACH</div><h2>Context first.<br/><em>Always.</em></h2><p>We are an architecture and design practice interested in creating spaces that are purposeful, enduring, and deeply connected to their surroundings.</p><p>Our process is collaborative: listening carefully, testing ideas, and refining every decision with intention.</p><button className="under-link" onClick={() => go('contact')}>Get in touch <ArrowUpRight size={15}/></button></div></section></>; }
function ContactPage() { const [sent,setSent] = useState(false); return <><PageIntro eyebrow="CONTACT / START A CONVERSATION" title="Tell us about" italic="your project." desc="Have an idea, a site, or simply a question? We would love to hear from you."/><section className="wrap contact-layout"><form className="public-form" onSubmit={e => {e.preventDefault();setSent(true);}}><div className="form-grid"><Field label="Your name" required placeholder="Full name"/><Field label="Email address" required type="email" placeholder="name@email.com"/><Field label="Phone number" placeholder="+62"/><label className="field"><span>Project type</span><select defaultValue=""><option value="" disabled>Select project type</option><option>Residential</option><option>Commercial</option><option>Interior</option><option>Other</option></select></label></div><Field label="Tell us a little about your project" required textarea placeholder="A short introduction to your project..."/><button className="btn btn-dark" type="submit">Send inquiry <ArrowUpRight size={16}/></button><button className="btn btn-outline" type="button" disabled>WhatsApp contact · number pending</button>{sent && <p className="form-success"><CheckCircle2 size={16}/> Demo: inquiry berhasil disiapkan. Integrasi email belum aktif.</p>}</form><aside className="contact-aside"><div><small>EMAIL</small><strong>Official studio email — to be confirmed</strong></div><div><small>LOCATION</small><strong>Jakarta, Indonesia</strong></div><div><small>WHATSAPP</small><strong>Official WhatsApp number — to be confirmed</strong></div></aside></section></>; }

  if(modal.type==='verify-payment') { const previousPaid=modal.invoice.payments.filter(x=>x.status==='Approved').reduce((s,x)=>s+x.approved,0); const remainingBefore=Math.max(0,modal.invoice.amount-previousPaid); const excess=Math.max(0,Number(form.approved??modal.payment.claimed)-remainingBefore); body=<form onSubmit={submit(()=>{const approved=Number(form.approved??modal.payment.claimed);if(!Number.isFinite(approved)||approved<=0)throw new Error('Nominal persetujuan harus lebih dari nol.');const reason=form.reason||'';if(approved!==modal.payment.claimed&&!reason.trim())throw new Error('Alasan wajib diisi jika nominal berbeda.');if(excess>0&&!form.overpaymentDecision)throw new Error('Pilih penanganan nominal lebih bayar.');updateProject(project.id,p=>{const invoices=p.invoices.map(i=>{if(i.id!==modal.invoice.id)return i;const payments=i.payments.map(x=>x.id===modal.payment.id?{...x,approved,status:'Approved',verifiedAt:nowLabel(),verifiedBy:'Admin NA',reason,overpaymentAmount:Math.max(0,approved-remainingBefore),overpaymentDecision:excess>0?form.overpaymentDecision:null,receipt:`RCPT-${project.code}-${i.payments.indexOf(x)+1}`} : x);const paid=payments.filter(x=>x.status==='Approved').reduce((s,x)=>s+x.approved,0);const pending=payments.some(x=>x.status==='Pending');return {...i,payments,status:paid>=i.amount?'Paid':pending?'Pending Verification':paid>0?'Partially Paid':'Unpaid'};});const stillDue=invoices.some(i=>i.status!=='Cancelled'&&i.amount>i.payments.filter(x=>x.status==='Approved').reduce((s,x)=>s+x.approved,0));return {...p,invoices,status:p.status==='On Hold'&&!stillDue?'Ready to Resume':p.status};});addActivity(project.id,'Payment verified',`${modal.invoice.number}: ${money(approved)} disetujui. ${reason}${excess>0?` Overpayment ${money(excess)}: ${form.overpaymentDecision}.`:''}`);finish('Pembayaran disetujui dan receipt demo diterbitkan.');})}><div className="payment-verify-summary"><small>{modal.invoice.number}</small><strong>{money(modal.payment.claimed)}</strong><span>Claimed by client · {dateFmt(modal.payment.date)}</span></div>{input('Approved amount (Rp)','approved',String(modal.payment.claimed),'number',true)}{excess>0&&<><div className="overpayment-callout"><AlertCircle size={15}/><span>Approved amount exceeds the remaining invoice balance by <strong>{money(excess)}</strong>.</span></div>{select('Overpayment handling','overpaymentDecision',[['','Select decision'],['Credit next invoice','Credit to next invoice'],['Refund','Refund to client']])}</>}{textarea('Reason (required if amount differs)','reason','Explain the adjustment, if any.') }<div className="modal-footnote">A receipt reference will be generated after approval. This is a demo record, not a fiscal receipt.</div>{footer('Approve payment')}</form>; }
  if(modal.type==='reject-payment') body=<form onSubmit={submit(()=>{if(!form.reason?.trim())throw new Error('Alasan penolakan wajib diisi.');updateProject(project.id,p=>({...p,invoices:p.invoices.map(i=>i.id===modal.invoice.id?{...i,payments:i.payments.map(x=>x.id===modal.payment.id?{...x,status:'Rejected',reason:form.reason}:x),status:i.payments.some(x=>x.id!==modal.payment.id&&x.status==='Pending')?'Pending Verification':i.payments.some(x=>x.status==='Approved')?'Partially Paid':'Unpaid'}:i)}));addActivity(project.id,'Payment rejected',`${modal.invoice.number}: ${form.reason}`);finish('Bukti pembayaran ditolak. Bukti lama tetap tersimpan.');})}><div className="payment-verify-summary"><small>{modal.invoice.number}</small><strong>{money(modal.payment.claimed)}</strong><span>{modal.payment.proof||'Payment proof'}</span></div>{textarea('Rejection reason','reason','Describe why the proof cannot be accepted.')}{footer('Reject proof')}</form>;

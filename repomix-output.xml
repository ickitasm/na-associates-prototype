import React, { useEffect, useState } from 'react';
import {
  ArrowLeft, ArrowRight, ArrowUpRight, Bell, Building2, CalendarDays, Check,
  CheckCircle2, ChevronDown, ChevronRight, ClipboardList, Clock3, CreditCard,
  Download, ExternalLink, FileCheck2, FileImage, FileText, FolderOpen, HardHat,
  Home, Image, LayoutDashboard, MapPin, Menu, MoreHorizontal, Package, Plus,
  RotateCcw, Search, Settings, ShieldCheck, ShoppingBag, Upload, User, UserPlus,
  Users, Wallet, X, Eye, Activity, AlertCircle
} from 'lucide-react';
import { Brand, ProgressBar, SectionHeading, FileTile, InvoiceClientCard, MonthlyRecap, StatusTag, EmptyState } from '../components/ui';
import { money, dateFmt } from '../lib/utils';

function ClientShell({ db, client, projects, selectedProject, page, setPage, onOpen, onBack, onLogout, onReset, onNotify, setModal, updateProject, addActivity, workspaceSection, setWorkspaceSection, mobileNav, setMobileNav }) {
  if (page === 'my-projects') return <ClientProjectsView client={client} projects={projects} onOpen={onOpen} onLogout={onLogout} onReset={onReset} setModal={setModal}/>;
  return <ClientWorkspace db={db} client={client} project={selectedProject} onBack={onBack} onLogout={onLogout} onReset={onReset} setModal={setModal} updateProject={updateProject} addActivity={addActivity} onNotify={onNotify} workspaceSection={workspaceSection} setWorkspaceSection={setWorkspaceSection} mobileNav={mobileNav} setMobileNav={setMobileNav}/>;
}
function ClientTopbar({ client, onBack, onLogout, onReset, setModal }) { return <header className="portal-topbar"><div className="portal-top-left"><Brand/><span className="portal-label">CLIENT PORTAL</span></div><div className="portal-top-right"><button className="icon-btn" onClick={() => setModal({type:'client-notifications'})}><Bell size={18}/><i className="notification-dot"/></button><div className="user-chip"><span className="avatar">{client?.name?.split(' ').map(x=>x[0]).slice(0,2).join('')}</span><span><strong>{client?.name || 'Client Demo'}</strong><small>Client account</small></span></div><button className="text-link" onClick={onLogout}>Sign out</button><button className="icon-btn mobile-menu" onClick={onReset} title="Reset demo"><RotateCcw size={16}/></button></div></header>; }
function ClientProjectsView({ client, projects, onOpen, onLogout, onReset, setModal }) { return <div className="client-app"><ClientTopbar client={client} onLogout={onLogout} onReset={onReset} setModal={setModal}/><main className="client-list-page"><div className="client-welcome"><div><div className="eyebrow">CLIENT SPACE / YOUR PROJECTS</div><h1>Good morning,<br/><em>{client?.name?.split(' ')[0] || 'there'}.</em></h1><p>Here is an overview of your projects with NA Associates.</p></div><div className="welcome-stamp">NA<br/><span>CLIENT SPACE</span></div></div><div className="list-heading"><div><span className="eyebrow">YOUR WORKSPACE</span><h2>My projects <small>{projects.length.toString().padStart(2,'0')}</small></h2></div><span className="muted">Select a project to view its details and updates.</span></div><div className="client-project-grid">{projects.map(p => <button className="client-project-card" key={p.id} onClick={() => onOpen(p.id)}><div className="client-project-image"><img src={p.cover}/><span className={`status-pill ${p.status === 'Completed' ? 'complete' : ''}`}>{p.status}</span></div><div className="client-project-info"><div className="project-card-top"><span>{p.code}</span><ArrowUpRight size={17}/></div><h3>{p.name}</h3><p><MapPin size={13}/>{p.location}</p><div className="progress-row"><span>PROJECT PROGRESS</span><strong>{p.progress}%</strong></div><ProgressBar value={p.progress}/><div className="client-project-bottom"><span>Next milestone</span><strong>{p.nextMilestone || '—'}</strong></div></div></button>)}</div>{!projects.length && <EmptyState title="Belum ada proyek" detail="Tim NA Associates akan menambahkan proyek ke akun Anda."/>}</main><div className="demo-bottom-note">DEMO MODE · Data tersimpan hanya di browser ini <button onClick={onReset}>Reset demo data</button></div></div>; }

const workspaceNav = [
  ['overview','Overview',Home],['design','A. Output & Design',Image],['progress','B. Progress & Field Ops',Activity],['legal','C. Legal Documents',FileText],['billing','D. Billing & Payments',Wallet],['shopping','E. Shopping List',ShoppingBag],['recap','F. Monthly Recap',CalendarDays]
];
function ClientWorkspace({ db, client, project, onBack, onLogout, onReset, setModal, updateProject, addActivity, onNotify, workspaceSection, setWorkspaceSection, mobileNav, setMobileNav }) {
  const [openSection, setOpenSection] = useState('overview');
  useEffect(() => { setOpenSection('overview'); }, [project?.id]);
  useEffect(() => {
    const handler = () => { const ids = workspaceNav.map(x=>x[0]); let current='overview'; ids.forEach(id => { const el=document.getElementById(`section-${id}`); if(el && el.getBoundingClientRect().top < 170) current=id; }); setOpenSection(current); };
    window.addEventListener('scroll', handler); return () => window.removeEventListener('scroll', handler);
  }, []);
  const jump = (id) => { setWorkspaceSection(id); setOpenSection(id); document.getElementById(`section-${id}`)?.scrollIntoView({behavior:'smooth',block:'start'}); setMobileNav(false); };
  const publishedReports = (project.reports||[]).filter(r=>r.visibility==='Published');
  const publishedFiles = (project.files||[]).filter(f=>f.visibility==='Published');
  const publishedLegal = (project.legal||[]).filter(f=>f.visibility==='Published');
  const publishedShopping = (project.shopping||[]).filter(s=>s.visibility==='Published');
  const invoices = project.invoices||[];
  const totalRemaining = invoices.filter(i=>i.status!=='Cancelled').reduce((sum,i)=>sum + Math.max(0,i.amount - i.payments.filter(p=>p.status==='Approved').reduce((s,p)=>s+p.approved,0)),0);
  return <div className="client-app"><ClientTopbar client={client} onBack={onBack} onLogout={onLogout} onReset={onReset} setModal={setModal}/><div className="workspace-shell"><aside className={`workspace-sidebar ${mobileNav?'sidebar-open':''}`}><button className="back-projects" onClick={onBack}><ArrowLeft size={15}/> All projects</button><div className="sidebar-project"><img src={project.cover}/><small>{project.code}</small><strong>{project.name}</strong><span><MapPin size={12}/>{project.location}</span></div><div className="workspace-nav-label">PROJECT WORKSPACE</div><nav className="workspace-nav">{workspaceNav.map(([id,label,Icon])=><button key={id} className={openSection===id?'active':''} onClick={()=>jump(id)}><Icon size={16}/><span>{label}</span>{id==='billing' && <i className="nav-count"/>}</button>)}</nav><div className="sidebar-progress"><div><small>OVERALL PROGRESS</small><strong>{project.progress}%</strong></div><ProgressBar value={project.progress}/><span>Target completion · {dateFmt(project.targetDate)}</span></div></aside><main className="workspace-main"><div className="workspace-topline"><div className="breadcrumb">My Projects <ChevronRight size={13}/> {project.name}</div><span className={`status-pill ${project.status==='Completed'?'complete':''}`}>{project.status}</span></div>
      <section className="workspace-hero" id="section-overview"><div className="workspace-hero-img"><img src={project.cover}/><div className="workspace-hero-overlay"/></div><div className="workspace-hero-content"><div className="eyebrow light">{project.code} / PROJECT OVERVIEW</div><h1>{project.name}<span>.</span></h1><p><MapPin size={14}/>{project.location}</p><div className="hero-progress"><span>PROJECT PROGRESS</span><strong>{project.progress}%</strong></div><ProgressBar value={project.progress}/></div></section>
      {(project.status==='On Hold'||project.status==='Ready to Resume')&&<div className={`project-status-notice ${project.status==='Ready to Resume'?'ready':''}`}><AlertCircle size={17}/><div><strong>{project.status==='On Hold'?'Project operations are on hold':'Project is ready to resume'}</strong><p>{project.status==='On Hold'?'You can still access existing reports, documents, invoices, and upload payment proof. New operational updates are paused.':'The studio is reviewing the next steps to resume project operations.'}</p></div></div>}<div className="workspace-stats"><div><small>LAND AREA</small><strong>{project.landArea || '—'}</strong></div><div><small>BUILDING AREA</small><strong>{project.buildingArea || '—'}</strong></div><div><small>NEXT MILESTONE</small><strong>{project.nextMilestone || '—'}</strong><span>{dateFmt(project.nextMilestoneDate)}</span></div><div><small>OUTSTANDING</small><strong>{money(totalRemaining)}</strong></div></div>
      <section className="workspace-section" id="section-design"><SectionHeading number="A" title="Output & Design" description="Design development and project deliverables shared by the studio." action="Browse files" onAction={()=>setModal({type:'file-list',project})}/><div className="file-grid">{publishedFiles.map(f=><FileTile key={f.id} file={f} onOpen={()=>setModal({type:'file-preview',file:f})}/>)}{!publishedFiles.length && <EmptyState title="No files published yet" detail="New design outputs will appear here once shared by the studio."/>}</div></section>
      <section className="workspace-section" id="section-progress"><SectionHeading number="B" title="Progress & Field Operations" description="A transparent view of milestones and published site updates."/><div className="progress-two-col"><div className="panel"><div className="panel-heading"><h3>Project timeline</h3><span className="subtle-tag">{project.milestones?.length||0} milestones</span></div><div className="timeline">{(project.milestones||[]).map((m,i)=><div className={`timeline-item ${m.status==='Completed'?'done':''} ${m.status==='In Progress'?'current':''}`} key={m.id}><div className="timeline-marker">{m.status==='Completed'?<Check size={12}/>:i+1}</div><div className="timeline-body"><div><strong>{m.title}</strong><span>{dateFmt(m.date)}</span></div><small>{m.status}</small>{m.status==='In Progress' && <ProgressBar value={m.progress}/>}</div></div>)}</div>{!project.milestones?.length && <EmptyState title="Timeline not available" detail="Milestones will appear here."/>}</div><div className="panel updates-panel"><div className="panel-heading"><h3>Latest updates</h3><span className="subtle-tag">Published</span></div>{publishedReports.slice(0,4).map(r=><article className="update-item" key={r.id}><div className="update-date">{dateFmt(r.date)}</div><div><strong>{r.title}</strong><p>{r.description}</p><span className="update-meta">{r.category} · {r.photos} site photos</span></div></article>)}{!publishedReports.length && <EmptyState title="No updates yet" detail="Published field reports will appear here."/>}</div></div></section>
      <section className="workspace-section" id="section-legal"><SectionHeading number="C" title="Legal Documents" description="Contracts, addenda, and approved supporting documents."/><div className="document-list">{publishedLegal.map(l=><div className="document-row" key={l.id}><span className="document-icon"><FileText size={19}/></span><div><strong>{l.name}</strong><small>{l.version} · {dateFmt(l.date)}</small></div><button className="icon-btn" onClick={()=>setModal({type:'file-preview',file:{name:l.name,type:'PDF',description:`${l.version} · ${dateFmt(l.date)}`}})}><Eye size={17}/></button><button className="icon-btn" onClick={()=>setModal({type:'info',title:'Demo document',body:'Preview/download dokumen akan terhubung ke Supabase Storage pada tahap backend.'})}><Download size={17}/></button></div>)}{!publishedLegal.length && <EmptyState title="No legal documents" detail="Approved documents will be shared here."/>}</div></section>
      <section className="workspace-section" id="section-billing"><SectionHeading number="D" title="Billing & Payments" description="Invoices, payment records, and official receipts." action="Upload payment proof" onAction={()=>setModal({type:'payment-upload',project})}/><div className="billing-summary"><div><small>TOTAL OUTSTANDING</small><strong>{money(totalRemaining)}</strong></div><div><small>INVOICES</small><strong>{invoices.filter(i=>i.status!=='Cancelled').length}</strong></div><div><small>PAYMENTS UNDER REVIEW</small><strong>{invoices.filter(i=>i.status!=='Cancelled').reduce((s,i)=>s+i.payments.filter(p=>p.status==='Pending').length,0)}</strong></div></div><div className="invoice-list">{invoices.filter(i=>i.status!=='Cancelled').map(inv=><InvoiceClientCard key={inv.id} invoice={inv} setModal={setModal}/>)}{!invoices.length && <EmptyState title="No invoices yet" detail="Invoices issued by the studio will appear here."/>}</div></section>
      <section className="workspace-section" id="section-shopping"><SectionHeading number="E" title="Shopping List" description="Materials planned for your project and their procurement status."/><div className="shopping-list">{publishedShopping.map(s=><div className="shopping-row" key={s.id}><div className="shopping-date">{dateFmt(s.date)}</div><div className="shopping-name"><strong>{s.material}</strong><small>{s.specification}</small></div><div className="shopping-qty">{s.quantity} {s.unit}</div><StatusTag value={s.status}/></div>)}{!publishedShopping.length && <EmptyState title="No materials published" detail="Material requirements will appear here."/>}</div></section>
      <section className="workspace-section" id="section-recap"><SectionHeading number="F" title="Monthly Recapitulation" description="A monthly overview of your invoices and verified payments."/><MonthlyRecap invoices={invoices}/></section>
      <footer className="workspace-footer"><Brand/><span>Need assistance? Contact the NA Associates team.</span><button className="under-link" onClick={()=>setModal({type:'info',title:'Contact the studio',body:'For project questions, contact hello@naassociates.com or use the official studio WhatsApp channel.'})}>Contact studio <ArrowUpRight size={14}/></button></footer><div className="demo-bottom-note">DEMO MODE · Simulasi UI, pembayaran, dan file. Bukan transaksi nyata.</div>
    </main></div><button className="mobile-workspace-nav" onClick={()=>setMobileNav(v=>!v)}><Menu size={17}/> Project sections <ChevronDown size={16}/></button></div>;
}
export { ClientShell };
</file>

<file path="src/pages/PublicSite.jsx">
import React, { useEffect, useState } from 'react';
import {
  ArrowLeft, ArrowRight, ArrowUpRight, Bell, Building2, CalendarDays, Check,
  CheckCircle2, ChevronDown, ChevronRight, ClipboardList, Clock3, CreditCard,
  Download, ExternalLink, FileCheck2, FileImage, FileText, FolderOpen, HardHat,
  Home, Image, LayoutDashboard, MapPin, Menu, MoreHorizontal, Package, Plus,
  RotateCcw, Search, Settings, ShieldCheck, ShoppingBag, Upload, User, UserPlus,

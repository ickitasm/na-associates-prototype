import React, { useState } from 'react';
import {
  ArrowLeft, ArrowRight, ArrowUpRight, Bell, Building2, CalendarDays, Check,
  CheckCircle2, ChevronDown, ChevronRight, ClipboardList, Clock3, CreditCard,
  Download, ExternalLink, FileCheck2, FileImage, FileText, FolderOpen, HardHat,
  Home, Image, LayoutDashboard, MapPin, Menu, MoreHorizontal, Package, Plus,
  RotateCcw, Search, Settings, ShieldCheck, ShoppingBag, Upload, User, UserPlus,
  Users, Wallet, X, Eye, Activity, AlertCircle
} from 'lucide-react';
import { Brand, ProgressBar, StatusTag, EmptyState, AdminPageHeader, Metric, ActivityTable } from '../components/ui';
import { money, dateFmt } from '../lib/utils';

const adminNav = [
  ['dashboard','Dashboard',LayoutDashboard],['projects','Projects',Building2],['clients','Clients & Accounts',Users],['operations','Field Operations',HardHat],['documents','Documents & Legal',FileText],['materials','Shopping & Materials',Package],['billing','Billing & Payments',Wallet],['notifications','Notifications',Bell],['activity','Activity Log',Activity],['content','Website Content',GlobeIcon],['settings','Settings',Settings]
];
function GlobeIcon(props) { return <ExternalLink {...props}/>; }
function AdminShell({ db,setDb,projects,clients,selectedProject,selectedProjectId,setSelectedProjectId,tab,setTab,onLogout,onReset,onNotify,setModal,updateProject,addActivity }) {
  const [sidebarOpen,setSidebarOpen] = useState(false);
  return <div className="admin-app"><aside className={`admin-sidebar ${sidebarOpen?'admin-sidebar-open':''}`}><div className="admin-brand"><Brand inverse/><span className="admin-label">STUDIO MANAGEMENT</span></div><div className="admin-nav-title">WORKSPACE</div><nav className="admin-nav">{adminNav.map(([id,label,Icon])=><button key={id} onClick={()=>{setTab(id);setSidebarOpen(false);}} className={tab===id?'active':''}><Icon size={17}/><span>{label}</span>{id==='billing' && <i className="nav-count">{db.projects.reduce((s,p)=>s+p.invoices.reduce((t,i)=>t+i.payments.filter(x=>x.status==='Pending').length,0),0)||''}</i>}</button>)}</nav><div className="admin-sidebar-bottom"><div className="admin-profile"><span className="avatar">NA</span><div><strong>NA Associates</strong><small>Primary Admin · Demo</small></div><MoreHorizontal size={16}/></div><button className="admin-reset" onClick={onReset}><RotateCcw size={14}/> Reset demo data</button><button className="admin-logout" onClick={onLogout}><ArrowLeft size={15}/> Back to public website</button></div></aside><main className="admin-main"><header className="admin-topbar"><div className="admin-top-left"><button className="icon-btn mobile-menu" onClick={()=>setSidebarOpen(v=>!v)}><Menu/></button><div className="breadcrumb">NA Associates <ChevronRight size={13}/> <strong>{adminNav.find(x=>x[0]===tab)?.[1]}</strong></div></div><div className="admin-top-actions"><span className="demo-label"><i/> DEMO ENVIRONMENT</span><button className="icon-btn" onClick={()=>setTab('notifications')}><Bell size={18}/><i className="notification-dot"/></button><span className="avatar">NA</span></div></header><div className="admin-content">{tab==='dashboard' && <AdminDashboard db={db} setTab={setTab} setModal={setModal}/>} {tab==='projects' && <AdminProjects projects={projects} clients={clients} setSelectedProjectId={setSelectedProjectId} setTab={setTab} setModal={setModal}/>} {tab==='clients' && <AdminClients clients={clients} projects={projects} setModal={setModal}/>} {tab==='operations' && <AdminOperations projects={projects} selectedProjectId={selectedProjectId} setSelectedProjectId={setSelectedProjectId} updateProject={updateProject} addActivity={addActivity} setModal={setModal}/>} {tab==='documents' && <AdminDocuments projects={projects} updateProject={updateProject} addActivity={addActivity} setModal={setModal}/>} {tab==='materials' && <AdminMaterials projects={projects} updateProject={updateProject} addActivity={addActivity} setModal={setModal}/>} {tab==='billing' && <AdminBilling projects={projects} updateProject={updateProject} addActivity={addActivity} setModal={setModal}/>} {tab==='notifications' && <AdminNotifications db={db} setDb={setDb}/>} {tab==='activity' && <AdminActivity projects={projects}/>} {tab==='content' && <AdminContent/>} {tab==='settings' && <AdminSettings onReset={onReset} admins={db.admins||[]} setModal={setModal}/>}</div></main></div>;
}

function AdminDashboard({ db,setTab,setModal }) {
  const projects=db.projects;
  const today=new Date(); today.setHours(0,0,0,0);
  const invoices=projects.flatMap(p=>p.invoices).filter(i=>i.status!=='Cancelled');
  const pending=invoices.reduce((s,i)=>s+i.payments.filter(p=>p.status==='Pending').length,0);
  const overdue=invoices.filter(i=>{const paid=i.payments.filter(p=>p.status==='Approved').reduce((sum,p)=>sum+p.approved,0);return i.status!=='Paid'&&i.amount>paid&&new Date(`${i.dueDate}T00:00:00`)<today;}).length;
  const onHold=projects.filter(p=>p.status==='On Hold').length;
  return <><AdminPageHeader eyebrow={`${today.toLocaleDateString('en-US',{weekday:'long',day:'2-digit',month:'long',year:'numeric'}).toUpperCase()} / OVERVIEW`} title="Good morning, NA team." description="Here is what is happening across your studio projects."/><div className="admin-metrics dashboard-metrics"><Metric icon={Building2} label="Total projects" value={projects.length} note="Across all categories"/><Metric icon={Activity} label="Ongoing projects" value={projects.filter(p=>p.status==='Active').length} note="Currently in progress"/><Metric icon={Users} label="Active clients" value={db.clients.filter(c=>c.status==='Active').length} note="Active client accounts"/><Metric icon={Wallet} label="Pending verification" value={pending} note="Payments to review" accent={pending>0}/><Metric icon={AlertCircle} label="Overdue invoices" value={overdue} note="Outstanding past due date" accent={overdue>0}/><Metric icon={Clock3} label="Projects on hold" value={onHold} note="Operational updates paused" accent={onHold>0}/></div><div className="admin-dashboard-grid"><section className="admin-panel"><div className="admin-panel-head"><div><h3>Project overview</h3><p>Progress across active projects</p></div><button className="under-link" onClick={()=>setTab('projects')}>All projects <ArrowUpRight size={14}/></button></div><div className="admin-project-list">{projects.slice(0,4).map(p=><div className="admin-project-row" key={p.id}><img src={p.cover}/><div className="admin-project-name"><strong>{p.name}</strong><small>{p.code} · {p.location}</small></div><div className="admin-project-progress"><div><span>{p.status}</span><strong>{p.progress}%</strong></div><ProgressBar value={p.progress}/></div><ChevronRight size={16}/></div>)}</div></section><section className="admin-panel"><div className="admin-panel-head"><div><h3>Quick actions</h3><p>Common studio tasks</p></div></div><div className="quick-actions"><button onClick={()=>setModal({type:'create-project'})}><span><Plus/></span><strong>Create project</strong><small>Set up a new project</small><ArrowUpRight size={15}/></button><button onClick={()=>setModal({type:'invite-client'})}><span><UserPlus/></span><strong>Invite client</strong><small>Give a client project access</small><ArrowUpRight size={15}/></button><button onClick={()=>setTab('operations')}><span><ClipboardList/></span><strong>Add progress report</strong><small>Record a site update</small><ArrowUpRight size={15}/></button><button onClick={()=>setTab('billing')}><span><CreditCard/></span><strong>Review payments</strong><small>{pending} waiting for review</small><ArrowUpRight size={15}/></button></div></section></div><section className="admin-panel recent-panel"><div className="admin-panel-head"><div><h3>Recent activity</h3><p>Latest changes across your projects</p></div><button className="under-link" onClick={()=>setTab('activity')}>View activity log <ArrowUpRight size={14}/></button></div><ActivityTable projects={projects} limit={5}/></section></>;
}
function AdminProjects({ projects,clients,setSelectedProjectId,setTab,setModal }) { const [q,setQ]=useState(''); const [status,setStatus]=useState('All'); const filtered=projects.filter(p=>(status==='All'||p.status===status)&&`${p.name} ${p.code} ${p.location}`.toLowerCase().includes(q.toLowerCase())); return <><AdminPageHeader eyebrow="STUDIO / PROJECTS" title="Projects" description="Manage project information, assignments, and progress." action="Create project" onAction={()=>setModal({type:'create-project'})}/><div className="admin-toolbar"><div className="search-field"><Search size={16}/><input placeholder="Search projects..." value={q} onChange={e=>setQ(e.target.value)}/></div><select value={status} onChange={e=>setStatus(e.target.value)}><option>All</option><option>Active</option><option>Completed</option><option>On Hold</option></select><span className="muted">{filtered.length} projects</span></div><div className="admin-project-cards">{filtered.map(p=><article className="admin-project-card" key={p.id}><div className="admin-project-card-photo"><img src={p.cover}/><span className={`status-pill ${p.status==='Completed'?'complete':''}`}>{p.status}</span></div><div className="admin-project-card-body"><div className="eyebrow">{p.code} · {p.category}</div><h3>{p.name}</h3><p><MapPin size={13}/>{p.location}</p><div className="admin-card-progress"><div><small>PROGRESS</small><strong>{p.progress}%</strong></div><ProgressBar value={p.progress}/></div><div className="admin-project-card-foot"><span>{clients.find(c=>c.id===p.clientId)?.name||'Unassigned'}</span><button className="under-link" onClick={()=>{setSelectedProjectId(p.id);setTab('operations');}}>Manage project <ArrowUpRight size={14}/></button></div></div></article>)}</div>{!filtered.length&&<EmptyState title="No matching projects" detail="Try a different search or filter."/>}</>; }
function AdminClients({ clients,projects,setModal }) { const [q,setQ]=useState(''); const filtered=clients.filter(c=>`${c.name} ${c.email}`.toLowerCase().includes(q.toLowerCase())); return <><AdminPageHeader eyebrow="STUDIO / ACCOUNTS" title="Clients & Accounts" description="Manage client invitations and their project access." action="Invite client" onAction={()=>setModal({type:'invite-client'})}/><div className="admin-toolbar"><div className="search-field"><Search size={16}/><input placeholder="Search clients..." value={q} onChange={e=>setQ(e.target.value)}/></div><span className="muted">{filtered.length} client accounts</span></div><div className="admin-panel table-panel"><table className="data-table"><thead><tr><th>CLIENT</th><th>EMAIL</th><th>PHONE</th><th>ASSIGNED PROJECTS</th><th>STATUS</th><th></th></tr></thead><tbody>{filtered.map(c=><tr key={c.id}><td><div className="table-person"><span className="avatar">{c.name.split(' ').map(x=>x[0]).slice(0,2).join('')}</span><strong>{c.name}</strong></div></td><td>{c.email}</td><td>{c.phone||'—'}</td><td>{c.projects.map(id=>projects.find(p=>p.id===id)?.name).filter(Boolean).join(', ')||'—'}</td><td><StatusTag value={c.status}/></td><td><button className="icon-btn" onClick={()=>setModal({type:'info',title:c.name,body:`${c.email}\n${c.phone}\n\nProject access: ${c.projects.map(id=>projects.find(p=>p.id===id)?.name).join(', ')}`})}><MoreHorizontal size={17}/></button></td></tr>)}</tbody></table>{!filtered.length&&<EmptyState title="No clients found" detail="Invite your first client to get started."/>}</div></>; }
function AdminOperations({ projects,selectedProjectId,setSelectedProjectId,updateProject,addActivity,setModal }) { const p=projects.find(x=>x.id===selectedProjectId)||projects[0]; const [filter,setFilter]=useState('All'); const reports=p?.reports||[]; return <><AdminPageHeader eyebrow="STUDIO / FIELD OPERATIONS" title="Field Operations" description="Record daily work, site conditions, and publish client-facing progress." action={p?.status!=='Active'?null:'New daily log'} onAction={()=>setModal({type:'new-report',project:p})}/><div className="admin-toolbar"><select value={p?.id||''} onChange={e=>setSelectedProjectId(e.target.value)}>{projects.map(x=><option value={x.id} key={x.id}>{x.name}</option>)}</select><select value={filter} onChange={e=>setFilter(e.target.value)}><option>All</option><option>Published</option><option>Draft</option></select><span className="muted">{reports.length} daily records</span></div><div className="admin-panel project-control-panel"><div><strong>Project status · {p?.status}</strong><p>{p?.status==='On Hold'?'Operational progress updates are paused. Existing reports and project records remain available.':p?.status==='Ready to Resume'?'Payment conditions are cleared. Confirm to resume operational updates.':p?.status==='Completed'?'This project is marked completed.':'Project operations are active.'}</p></div>{p?.status==='Active'&&<button className="btn btn-small btn-outline" onClick={()=>{if(window.confirm('Place this project on hold? Existing client access and records will remain available.')){updateProject(p.id,x=>({...x,status:'On Hold'}));addActivity(p.id,'Project placed on hold','Admin confirmed operational hold.');}}}>Place on hold</button>}{p?.status==='On Hold'&&<button className="btn btn-small btn-outline" onClick={()=>{updateProject(p.id,x=>({...x,status:'Ready to Resume'}));addActivity(p.id,'Project ready to resume','Admin marked project ready for resume review.');}}>Mark ready to resume</button>}{p?.status==='Ready to Resume'&&<button className="btn btn-small btn-dark" onClick={()=>{updateProject(p.id,x=>({...x,status:'Active'}));addActivity(p.id,'Project resumed','Admin confirmed project resume.');}}>Confirm resume</button>}</div><div className="admin-panel"><div className="admin-panel-head"><div><h3>{p?.name} / Daily project logs</h3><p>Reports are private until Admin publishes them.</p></div><span className="subtle-tag">{p?.code}</span></div><div className="log-list">{reports.filter(r=>filter==='All'||r.visibility===filter).map(r=><article className="log-card" key={r.id}><div className="log-card-date">{dateFmt(r.date)}<span>{r.category}</span></div><div className="log-card-main"><h4>{r.title}</h4><p>{r.description}</p><small>{r.photos} attachments · Progress {r.progress}%</small></div><div className="log-card-actions"><StatusTag value={r.visibility}/><button className="btn btn-small btn-outline" onClick={()=>{updateProject(p.id,x=>({...x,reports:x.reports.map(y=>y.id===r.id?{...y,visibility:y.visibility==='Published'?'Draft':'Published'}:y)}));addActivity(p.id,'Report visibility changed',`${r.title} diubah menjadi ${r.visibility==='Published'?'Draft':'Published'}.`);}}> {r.visibility==='Published'?'Unpublish':'Publish'} </button></div></article>)}{!reports.length&&<EmptyState title="No daily logs" detail="Create the first field report for this project."/>}</div></div><div className="admin-panel note-panel"><ShieldCheck size={19}/><div><strong>Client visibility rule</strong><p>Hanya laporan berstatus Published yang tampil di Client Portal. Attendance dan catatan internal tetap disembunyikan.</p></div></div></>; }
function AdminDocuments({projects,updateProject,addActivity,setModal}) { const [pid,setPid]=useState(projects[0]?.id); const p=projects.find(x=>x.id===pid)||projects[0]; const docs=p?.files||[]; return <><AdminPageHeader eyebrow="STUDIO / DOCUMENT CONTROL" title="Documents & Legal" description="Manage project files, contract versions, and client visibility." action="Upload document" onAction={()=>setModal({type:'new-document',project:p})}/><div className="admin-toolbar"><select value={pid} onChange={e=>setPid(e.target.value)}>{projects.map(x=><option key={x.id} value={x.id}>{x.name}</option>)}</select><span className="muted">Design files and legal records</span></div><div className="admin-panel"><div className="admin-panel-head"><div><h3>{p?.name}</h3><p>Project files</p></div></div><div className="document-list admin-doc-list">{docs.map(d=><div className="document-row" key={d.id}><span className="document-icon"><FileText size={19}/></span><div><strong>{d.name}</strong><small>{d.category} · {dateFmt(d.date)}</small></div><StatusTag value={d.visibility}/><button className="btn btn-small btn-outline" onClick={()=>{updateProject(p.id,x=>({...x,files:x.files.map(y=>y.id===d.id?{...y,visibility:y.visibility==='Published'?'Internal Only':'Published'}:y)}));addActivity(p.id,'File visibility changed',`${d.name} visibility diperbarui.`);}}> {d.visibility==='Published'?'Make internal':'Publish'} </button></div>)}{!docs.length&&<EmptyState title="No documents" detail="Upload a project file to begin."/>}</div></div><div className="admin-panel"><div className="admin-panel-head"><div><h3>Legal documents</h3><p>Contracts and addenda visible to the selected project.</p></div><button className="btn btn-outline btn-small" onClick={()=>setModal({type:'new-legal',project:p})}><Plus size={14}/> Add legal document</button></div>{(p?.legal||[]).map(d=><div className="document-row" key={d.id}><span className="document-icon"><FileCheck2 size={19}/></span><div><strong>{d.name}</strong><small>{d.version} · {dateFmt(d.date)}</small></div><StatusTag value={d.visibility}/><button className="btn btn-small btn-outline" onClick={()=>updateProject(p.id,x=>({...x,legal:x.legal.map(y=>y.id===d.id?{...y,visibility:y.visibility==='Published'?'Internal Only':'Published'}:y)}))}>{d.visibility==='Published'?'Make internal':'Publish'}</button></div>)}</div></>; }
function AdminMaterials({projects,updateProject,addActivity,setModal}) { const [pid,setPid]=useState(projects[0]?.id); const p=projects.find(x=>x.id===pid)||projects[0]; return <><AdminPageHeader eyebrow="STUDIO / PROCUREMENT" title="Shopping & Materials" description="Track material requirements, procurement, and actual site usage." action="Add material" onAction={()=>setModal({type:'new-material',project:p})}/><div className="admin-toolbar"><select value={pid} onChange={e=>setPid(e.target.value)}>{projects.map(x=><option key={x.id} value={x.id}>{x.name}</option>)}</select><span className="subtle-tag">{p?.code}</span></div><div className="admin-panel"><div className="admin-panel-head"><div><h3>Shopping list / Procurement</h3><p>Internal purchasing details are not shared with clients.</p></div></div><div className="material-table">{(p?.shopping||[]).map(s=><div className="material-row" key={s.id}><div className="material-main"><strong>{s.material}</strong><small>{s.specification} · Need by {dateFmt(s.date)}</small></div><div>{s.quantity} {s.unit}</div><div className="material-cost"><small>INTERNAL ESTIMATE</small><strong>{money(s.unitCost*s.quantity)}</strong></div><select value={s.status} onChange={e=>updateProject(p.id,x=>({...x,shopping:x.shopping.map(y=>y.id===s.id?{...y,status:e.target.value}:y)}))}><option>Belum Dibeli</option><option>Dalam Proses</option><option>Sudah Dibeli</option></select><div className="material-publish"><StatusTag value={s.visibility}/><button className="btn btn-small btn-outline" onClick={()=>{updateProject(p.id,x=>({...x,shopping:x.shopping.map(y=>y.id===s.id?{...y,visibility:y.visibility==='Published'?'Draft':'Published'}:y)}));addActivity(p.id,'Shopping list visibility changed',`${s.material} visibility diperbarui.`);}}>{s.visibility==='Published'?'Unpublish':'Publish'}</button></div></div>)}{!p?.shopping?.length&&<EmptyState title="No materials yet" detail="Add requirements for this project."/>}</div></div><div className="admin-panel"><div className="admin-panel-head"><div><h3>Material usage</h3><p>Materials recorded as actually used on site.</p></div><button className="btn btn-outline btn-small" onClick={()=>setModal({type:'new-usage',project:p})}><Plus size={14}/> Record usage</button></div>{(p?.usage||[]).map(u=><div className="usage-row" key={u.id}><span><Package size={17}/></span><div><strong>{u.material}</strong><small>{dateFmt(u.date)} · {u.area}</small></div><strong>{u.quantity} {u.unit}</strong></div>)}{!p?.usage?.length&&<EmptyState title="No usage records" detail="Record material usage from daily site activity."/>}</div></>; }
function AdminBilling({projects,updateProject,addActivity,setModal}) { const [pid,setPid]=useState(projects[0]?.id); const p=projects.find(x=>x.id===pid)||projects[0]; const invoices=p?.invoices||[]; const activeInvoices=invoices.filter(i=>i.status!=='Cancelled'); const pending=activeInvoices.flatMap(i=>i.payments.map(pay=>({...pay,invoice:i}))).filter(x=>x.status==='Pending'); const today=new Date(); today.setHours(0,0,0,0); const holdCandidates=invoices.filter(i=>{const paid=i.payments.filter(x=>x.status==='Approved').reduce((s,x)=>s+x.approved,0);const daysLate=Math.floor((today-new Date(`${i.dueDate}T00:00:00`))/86400000);return i.status!=='Cancelled'&&i.status!=='Paid'&&paid<i.amount&&daysLate>=7&&!i.payments.some(x=>x.status==='Pending');}); return <><AdminPageHeader eyebrow="STUDIO / FINANCIAL MANAGEMENT" title="Billing & Payments" description="Issue invoices, review payment proofs, and maintain financial history." action="Create invoice" onAction={()=>setModal({type:'new-invoice',project:p})}/><div className="admin-toolbar"><select value={pid} onChange={e=>setPid(e.target.value)}>{projects.map(x=><option key={x.id} value={x.id}>{x.name}</option>)}</select><span className="muted">{invoices.length} invoices</span></div><div className="admin-metrics billing-metrics"><Metric icon={FileText} label="Active invoices" value={invoices.filter(i=>i.status!=='Cancelled').length} note="Issued documents"/><Metric icon={Clock3} label="Pending proofs" value={pending.length} note="Require verification" accent={pending.length>0}/><Metric icon={Wallet} label="Verified payments" value={money(activeInvoices.reduce((s,i)=>s+i.payments.filter(x=>x.status==='Approved').reduce((t,x)=>t+x.approved,0),0))} note="Approved payment total"/><Metric icon={AlertCircle} label="Outstanding" value={money(invoices.filter(i=>i.status!=='Cancelled').reduce((s,i)=>s+Math.max(0,i.amount-i.payments.filter(x=>x.status==='Approved').reduce((t,x)=>t+x.approved,0)),0))} note="Remaining amount"/></div>{holdCandidates.length>0&&p?.status==='Active'&&<div className="admin-panel hold-recommendation"><div><strong><AlertCircle size={16}/> Hold recommendation · H+7</strong><p>{holdCandidates.map(i=>i.number).join(', ')} has remaining payment beyond seven days after due date. Pending verification pauses this clock.</p></div><button className="btn btn-small btn-dark" onClick={()=>{if(window.confirm('Confirm placing this project on hold? Existing portal access and payment uploads will remain available.')){updateProject(p.id,x=>({...x,status:'On Hold'}));addActivity(p.id,'Project placed on hold','H+7 payment recommendation confirmed by Admin.');}}}>Confirm hold</button></div>}<div className="admin-panel"><div className="admin-panel-head"><div><h3>Payment verification</h3><p>Review claims and approve only the verified amount.</p></div><span className="subtle-tag">{pending.length} pending</span></div>{pending.map(pay=><div className="payment-review-row" key={pay.id}><div className="proof-placeholder"><FileImage size={22}/><small>PROOF</small></div><div className="payment-review-main"><strong>{pay.invoice.number}</strong><small>{dateFmt(pay.date)} · Claimed {money(pay.claimed)}</small><span>{pay.proof||'Payment proof uploaded'}</span></div><div className="payment-review-actions"><button className="btn btn-small btn-dark" onClick={()=>setModal({type:'verify-payment',project:p,invoice:pay.invoice,payment:pay})}><Check size={14}/> Review & verify</button><button className="btn btn-small btn-outline" onClick={()=>setModal({type:'reject-payment',project:p,invoice:pay.invoice,payment:pay})}>Reject</button></div></div>)}{!pending.length&&<EmptyState title="All caught up" detail="There are no payment proofs waiting for review."/>}</div><div className="admin-panel"><div className="admin-panel-head"><div><h3>Invoice register</h3><p>Issued invoices are retained as financial history.</p></div></div>{invoices.map(i=><InvoiceAdminRow key={i.id} invoice={i} setModal={setModal} project={p}/>)}{!invoices.length&&<EmptyState title="No invoices" detail="Create an invoice for this project."/>}</div></>; }
function InvoiceAdminRow({invoice,setModal,project}) { const paid=invoice.payments.filter(p=>p.status==='Approved').reduce((s,p)=>s+p.approved,0); return <div className="invoice-admin-row"><div><strong>{invoice.number}</strong><small>Issued {dateFmt(invoice.issueDate)} · Due {dateFmt(invoice.dueDate)}</small></div><strong>{money(invoice.amount)}</strong><span>{money(paid)} paid</span><StatusTag value={invoice.status}/><div className="invoice-actions"><button className="icon-btn" title="Details" onClick={()=>setModal({type:'invoice-detail-admin',invoice,project})}><Eye size={16}/></button>{invoice.status!=='Paid'&&invoice.status!=='Cancelled'&&<button className="icon-btn" title="Revise invoice" onClick={()=>setModal({type:'revise-invoice',project,invoice})}><RotateCcw size={16}/></button>}</div></div>; }
function AdminNotifications({db,setDb}) { return <><AdminPageHeader eyebrow="STUDIO / COMMUNICATION" title="Notifications" description="Monitor events and communication activity across projects."/><div className="admin-panel"><div className="admin-panel-head"><div><h3>Recent notifications</h3><p>Demo notifications from project activity.</p></div><button className="under-link" onClick={()=>setDb(old=>({...old,notifications:old.notifications.map(n=>({...n,read:true}))}))}>Mark all read</button></div>{db.notifications.map(n=><div className={`notification-row ${n.read?'read':''}`} key={n.id}><span className="notification-icon"><Bell size={17}/></span><div><strong>{n.title}</strong><p>{n.body}</p><small>{dateFmt(n.date)}</small></div>{!n.read&&<i className="unread-dot"/>}</div>)}</div></>; }
function AdminActivity({projects}) { return <><AdminPageHeader eyebrow="STUDIO / AUDIT TRAIL" title="Activity Log" description="A chronological record of important actions across project workspaces."/><div className="admin-panel"><ActivityTable projects={projects}/></div><div className="admin-panel note-panel"><ShieldCheck size={19}/><div><strong>Production security note</strong><p>Prototype activity records are editable demo data. For production, critical logs should be append-only and enforced by Supabase database policies or trusted server functions.</p></div></div></>; }
function AdminContent() { return <><AdminPageHeader eyebrow="STUDIO / PUBLIC WEBSITE" title="Website Content" description="Manage the public-facing pages and featured portfolio content."/><div className="admin-content-grid">{[['Projects','Portfolio items and project detail pages','Manage portfolio'],['Services','Service descriptions and supporting images','Edit services'],['About','Studio profile and approach','Edit about'],['Career','Career introduction and positions','Edit career'],['Contact','Studio email, phone, and WhatsApp','Edit contact'],['Homepage','Hero text and featured projects','Edit homepage']].map(([title,desc,cta])=><div className="admin-panel content-manage-card" key={title}><span><FileText size={19}/></span><h3>{title}</h3><p>{desc}</p><button className="under-link" onClick={()=>alert('Demo: content editor belum dihubungkan.')}>{cta} <ArrowUpRight size={14}/></button></div>)}</div></>; }

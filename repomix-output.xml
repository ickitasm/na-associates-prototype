  const titleMap={login:'Enter your project space', 'invite-admin':'Invite an Admin', 'create-project':'Create a new project','invite-client':'Invite a client','payment-upload':'Upload payment proof','verify-payment':'Verify payment','reject-payment':'Reject payment proof','revise-invoice':'Revise invoice','new-invoice':'Create invoice','new-report':'New daily project log','new-document':'Upload project file','new-legal':'Add legal document','new-material':'Add material requirement','new-usage':'Record material usage','invoice-detail':'Invoice details','invoice-detail-admin':'Invoice details','invoice-detail':'Invoice details','file-preview':'File preview','file-list':'Project files','client-notifications':'Notifications','info':modal.title||'Information'};

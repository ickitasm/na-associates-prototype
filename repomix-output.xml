  if(modal.type==='file-preview') body=<div className="file-preview-modal"><div className="preview-art"><FileText size={44}/><span>DOCUMENT PREVIEW</span></div><h3>{modal.file?.name}</h3><p>{modal.file?.description||'Preview dokumen demo. File storage belum terhubung.'}</p><div className="file-preview-meta"><span>File type <strong>{modal.file?.type||'PDF'}</strong></span><span>Access <strong>Demo preview</strong></span></div><div className="modal-actions"><button className="btn btn-outline" onClick={close}>Close</button><button className="btn btn-dark" onClick={()=>notify('Download dinonaktifkan: file demo belum tersedia.')}> <Download size={15}/> Download</button></div></div>;
  if(modal.type==='file-list') body=<div className="document-list">{(project.files||[]).filter(f=>f.visibility==='Published').map(f=><div className="document-row" key={f.id}><span className="document-icon"><FileText/></span><div><strong>{f.name}</strong><small>{f.category} · {dateFmt(f.date)}</small></div><StatusTag value={f.visibility}/></div>)}</div>;
  if(modal.type==='client-notifications') body=<div className="notification-modal-list">{db.notifications.map(n=><div className="notification-row" key={n.id}><span className="notification-icon"><Bell size={17}/></span><div><strong>{n.title}</strong><p>{n.body}</p><small>{dateFmt(n.date)}</small></div></div>)}</div>;
  if(modal.type==='info') body=<div><p className="modal-lead preserve-lines">{modal.body}</p><div className="modal-actions"><button className="btn btn-dark" onClick={close}>Close</button></div></div>;
  return <div className="modal-backdrop" onMouseDown={e=>{if(e.target===e.currentTarget)close();}}><section className="modal-card"><header className="modal-header"><div><div className="eyebrow">NA ASSOCIATES / DEMO</div><h2>{title}</h2></div><button className="icon-btn" onClick={close}><X size={19}/></button></header><div className="modal-body">{body}{error&&<div className="form-error"><AlertCircle size={15}/>{error}</div>}</div></section></div>;
}
export { ModalHost };
